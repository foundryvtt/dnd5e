<div class="form-group">
    <label>{{ localize "DND5E.ADVANCEMENT.FIELDS.name.label" }}</label>
    <div class="form-fields">
        <input type="text" name="name" value="{{ source.name }}" placeholder="{{ default.title }}">
    </div>
</div>

<div class="form-group">
    <label>{{ localize "DND5E.ADVANCEMENT.FIELDS.img.label" }}</label>
    <div class="form-fields">
        <file-picker type="image" name="img" value="{{ source.img }}" placeholder="{{ default.icon }}"></file-picker>
    </div>
</div>

{{#if showClassRestrictions}}
<div class="form-group">
    <label>{{ localize "DND5E.ADVANCEMENT.FIELDS.classRestriction.label" }}</label>
    <div class="form-fields">
        <select name="classRestriction">
            {{ selectOptions classRestrictionOptions selected=source.classRestriction}}
        </select>
    </div>
</div>
{{/if}}

{{#if showLevelSelector}}
<div class="form-group">
    <label>{{ localize "DND5E.ADVANCEMENT.FIELDS.level.label" }}</label>
    <div class="form-fields">
        <select name="level" data-dtype="Number">
            {{ selectOptions levels selected=source.level }}
        </select>
    </div>
</div>
{{/if}}

{{#if supportsHTMLHint}}
<prose-mirror class="slim" name="hint" value="{{ source.hint }}" compact
              {{#if default.hint}}placeholder="{{ default.hint }}"{{/if}}></prose-mirror>
{{else}}
<div class="form-group">
    <label>{{ localize "DND5E.ADVANCEMENT.FIELDS.hint.label" }}</label>
    <div class="form-fields">
        <textarea name="hint" {{~#if default.hint}} placeholder="{{ default.hint }}"{{/if}}>{{ source.hint }}</textarea>
    </div>
</div>
{{/if}}
