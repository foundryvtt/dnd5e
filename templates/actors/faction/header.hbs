<section class="sheet-header">

    {{!-- Portrait --}}
    <div class="left">
        <div class="portrait">
            <img src="{{ document.img }}" alt="{{ document.name }}"
                {{#if editable}}data-action="editImage" data-edit="img"{{/if}}>
        </div>
    </div>

    {{!-- Name & Category --}}
    <div class="middle">

        {{!-- Name --}}
        {{#if editable}}
        <input type="text" name="name" class="document-name uninput" value="{{ actor._source.name }}">
        {{else}}
        <div class="document-name">{{ document.name }}</div>
        {{/if}}

        {{!-- Category --}}
        <ul class="subtitles unlist">
            {{~#if editable}}
            {{#if category.options.length}}
            <li>{{ formInput fields.type.fields.value value=source.type.value options=category.options blank="" }}</li>
            {{/if}}
            {{else if category.label}}
            <li><span>{{ category.label }}</span></li>
            {{/if~}}
        </ul>

    </div>

    <div class="right"></div>
</section>
