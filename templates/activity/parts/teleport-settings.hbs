<fieldset>
    <legend>{{ localize "DND5E.TELEPORT.FIELDS.teleport.label" }}</legend>
    {{ formField fields.teleport.fields.override value=source.teleport.override input=inputs.createCheckboxInput
                 rootId=partId }}
    <div class="form-group split-group">
        <label>{{ localize "DND5E.TELEPORT.FIELDS.teleport.value.label" }}</label>
        <div class="form-fields">
            {{ formField fields.teleport.fields.value value=distance.data.value label=(localize "DND5E.Value")
                         classes="label-top" placeholder="∞" disabled=distance.disabled rootId=partId }}
            {{ formField fields.teleport.fields.units value=distance.data.units label=(localize "DND5E.Unit")
                         choices=CONFIG.movementUnits classes="label-top" disabled=distance.disabled
                         rootId=partId }}
        </div>
    </div>
    <p class="hint">{{ localize "DND5E.TELEPORT.FIELDS.teleport.hint" }}</p>
</fieldset>
