<section>
    <menu class="unlist">
        {{#each activities}}
        <li>
            <button type="button" data-action="choose" data-activity-id="{{ id }}">
                <span class="icon">
                    {{ dnd5e-icon img alt=name classes="gold-icon" }}
                </span>
                <span class="name">{{ name }}</span>
                {{#with uses}}
                <span class="uses {{#if (eq 0 value)}}expended{{/if}}">
                    <span class="value">{{ value }}</span>
                    <span class="separator">&sol;</span>
                    <span class="max">{{ max }}</span>
                </span>
                {{/with}}
            </button>
        </li>
        {{/each}}
    </menu>

    {{#if controlHint}}
    <div class="control-hint ff-hint">{{{ controlHint }}}</div>
    {{/if}}
</section>
