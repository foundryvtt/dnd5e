<section class="tab activity-{{ tab.id }} {{ tab.cssClass }}" data-tab="{{ tab.id }}" data-group="{{ tab.group }}">
    <fieldset>
        <legend>{{ localize "DND5E.FORWARD.FIELDS.target.label" }}</legend>
        <div class="form-group">
            <label>{{ localize "DND5E.FORWARD.FIELDS.Item.label" }}</label>
            <div class="form-fields">
                {{#if actor}}
                    {{ formInput fields.targetItem value=displayTargetItem options=itemOptions }}
                {{else}}
                    <input type="text" name="targetItem" value="{{ source.targetItem }}" placeholder="{{ localize 'DND5E.FORWARD.Target.Item.Placeholder' }}">
                {{/if}}
            </div>
        </div>
        <div class="form-group">
            <label>{{ localize "DND5E.FORWARD.FIELDS.Activity.label" }}</label>
            <div class="form-fields">
                {{#if showActivitySelect}}
                    {{ formInput fields.activity value=source.activity options=activityOptions }}
                {{else}}
                    <input type="text" name="activity" value="{{ source.activity }}" placeholder="{{ localize 'DND5E.FORWARD.Activity.Placeholder' }}">
                {{/if}}
            </div>
        </div>
    </fieldset>
</section>
