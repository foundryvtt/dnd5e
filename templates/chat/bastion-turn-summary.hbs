<div class="chat-card bastion-card">

    {{!-- Orders --}}
    {{#if orders.length}}
    <ul class="unlist order-summary">
        {{#each orders}}
        <li>{{{ localize "DND5E.Bastion.Summary.Order" link=contentLink order=order }}}</li>
        {{/each}}
    </ul>
    {{else}}
    <p class="order-description">{{ localize "DND5E.Bastion.Summary.NoOrders" }}</p>
    {{/if}}

    {{!-- Supplements --}}
    {{#each supplements}}
    <p class="supplement">{{{ this }}}</p>
    {{/each}}

    {{!-- Buttons --}}
    {{> "dnd5e.card-buttons" }}

    {{!-- Items --}}
    {{#if items.length}}
    <section class="icon-row">
        <i class="fa-fw fa-solid fa-treasure-chest" aria-label="{{ localize "DND5E.CHATMESSAGE.Row.Items" }}"></i>
        <ul class="unlist item-summary">
            {{#each items}}
            <li class="item-tooltip{{#if claimed}} claimed{{/if}}" data-uuid="{{ uuid }}" data-index="{{ index }}"
                data-quantity="{{ quantity }}" data-action="viewItem" data-tooltip-html="{{ dnd5e-tooltip uuid=uuid }}">
                <img src="{{ img }}" alt="{{ name }}">
                <div class="quantity">&times;{{ quantity }}</div>
            </li>
            {{/each}}
        </ul>
    </section>
    {{/if}}

</div>
