<table class="core-traits">
    <caption>{{ localize "JOURNALENTRYPAGE.DND5E.Class.Traits.Caption" class=linked.name }}</caption>
    <tbody>
        <tr>
            <th scope="row">{{ localize "DND5E.CLASS.FIELDS.primaryAbility.value.label" }}</th>
            <td>{{ primaryAbility }}</td>
        </tr>
        <tr>
            <th scope="row">{{ localize "DND5E.CLASS.FIELDS.hd.label" }}</th>
            <td>{{ localize "JOURNALENTRYPAGE.DND5E.Class.HitPoints.HitDiceModern" dice=advancement.hp.hitDice
                   class=linked.name }}</td>
        </tr>
        <tr>
            <th scope="row">{{ localize "DND5E.TRAIT.Save.title" }}</th>
            <td>{{ advancement.traits.saves }}</td>
        </tr>
        <tr>
            <th scope="row">{{ localize "DND5E.TRAIT.Skill.title" }}</th>
            <td>{{ advancement.traits.skills }}</td>
        </tr>
        <tr>
            <th scope="row">{{ localize "DND5E.TRAIT.Weapon.title" }}</th>
            <td>{{ advancement.traits.weapons }}</td>
        </tr>
        <tr>
            <th scope="row">{{ localize "DND5E.TRAIT.Tool.title" }}</th>
            <td>{{ advancement.traits.tools }}</td>
        </tr>
        <tr>
            <th scope="row">{{ localize "DND5E.TRAIT.Armor.title" }}</th>
            <td>{{ advancement.traits.armor }}</td>
        </tr>
        <tr>
            <th scope="row">{{ localize "DND5E.StartingEquipment.Title" }}</th>
            <td>{{{ advancement.equipment }}}</td>
        </tr>
    </tbody>
</table>
